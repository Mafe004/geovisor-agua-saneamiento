# ============================================================
# GEOVISOR API - Agua y Saneamiento
# Copia este archivo como .env y rellena los valores reales
# NUNCA subas el .env real a GitHub
# ============================================================

# --- Base de datos MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_password_aqui
DB_NAME=geovisor_agua_saneamiento

# Tamaño máximo del pool de conexiones (por proceso). DEBE quedar por
# debajo de max_connections en el servidor MySQL (151 por defecto) — si
# uvicorn corre con varios workers, cada uno abre su propio pool, así que
# lo que hay que comparar contra ese límite es workers × DB_POOL_SIZE, no
# este número solo.
DB_POOL_SIZE=10

# --- JWT ---
# OBLIGATORIO: mínimo 32 caracteres. La app se niega a arrancar sin esto.
# Genera una clave segura con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CAMBIA_ESTO_POR_UNA_CLAVE_SEGURA_DE_AL_MENOS_32_CARACTERES
# El algoritmo NO es configurable (fijo en HS256 en el código) para evitar
# que un valor de entorno debilite la verificación del token.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---
# Orígenes permitidos, separados por coma. Nunca uses "*" con credenciales.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# --- Logging ---
LOG_LEVEL=INFO

# --- Auditoría / IP del cliente ---
# La IP registrada en logs_auditoria viene de request.client.host por
# defecto. Solo pon esto en true si el backend corre detrás de un proxy
# reverso/load balancer de confianza que setea X-Forwarded-For de forma
# fiable — de lo contrario un cliente puede falsificar esa cabecera y
# aparecer en el log con la IP que quiera.
TRUST_PROXY=false

# --- Servidor ---
HOST=0.0.0.0
PORT=8000
