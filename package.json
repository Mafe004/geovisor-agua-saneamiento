{
  "name": "geovisor-agua-saneamiento",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:backend": "turbo run dev --filter=@geovisor/backend",
    "dev:frontend": "turbo run dev --filter=geovisor-app",
