{
  "expo": {
    "name": "GeoVisor Agua",
    "slug": "geovisor-agua",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "sdkVersion": "57.0.0",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.zipaquira.geovisor"
    },
    "android": {
      "package": "com.zipaquira.geovisor",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#1565C0",
        "foregroundImage": "./assets/icon.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1565C0",
          "resizeMode": "contain"
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-status-bar",
      "expo-web-browser"
    ]
  }
}
