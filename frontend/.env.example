# Copia este archivo como .env y rellena tu API key real.
# NUNCA subas el .env real a GitHub (ya está en .gitignore).
#
# El prefijo EXPO_PUBLIC_ hace que Expo/Metro inyecte esta variable en el
# bundle de JS automáticamente al arrancar - no requiere configuración extra.
# Ver: https://docs.expo.dev/guides/environment-variables/

EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
