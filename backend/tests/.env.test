# ============================================================
# Config de la suite de integración — NUNCA apunta a la base de
# desarrollo. conftest.py se niega a correr si DB_NAME no termina en
# "_test" (ver el guard al inicio de ese archivo).
#
# DB_HOST/DB_PORT/DB_USER/DB_PASSWORD se toman del backend/.env real (mismo
# servidor MySQL local) — solo se pisan aquí el nombre de la base y el
# SECRET_KEY, para que los tokens de los tests sean deterministas y la app
# nunca toque geovisor_agua_saneamiento.
# ============================================================

DB_NAME=geovisor_test

# Cualquier clave fija de 32+ caracteres sirve — nunca se usa fuera de esta
# suite, así que no necesita ser secreta de verdad.
SECRET_KEY=test-secret-key-solo-para-pytest-nunca-usar-en-produccion-00
ACCESS_TOKEN_EXPIRE_MINUTES=60

LOG_LEVEL=WARNING
