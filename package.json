    "lint:fix": "turbo run lint:fix"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  },
  "packageManager": "npm@11.6.2",
  "overrides": {
    "react-native-web": {
      "react": "19.0.0",
      "react-dom": "19.0.0"
    }
  }
}
